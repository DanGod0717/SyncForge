<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.syncforge.document.mapper.DocumentMapper">

    <resultMap id="DocumentResultMap" type="com.example.syncforge.document.entity.Document">
        <id property="id" column="id"/>
        <result property="ownerUserId" column="owner_user_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="version" column="version"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="DocumentResultMap">
        SELECT * FROM documents WHERE id = #{id} AND is_deleted = 0
    </select>

    <insert id="insert" parameterType="com.example.syncforge.document.entity.Document"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO documents (owner_user_id, title, content, version, is_deleted)
        VALUES (#{ownerUserId}, #{title}, #{content}, #{version}, #{isDeleted})
    </insert>

    <update id="updateContentByIdAndVersion">
        UPDATE documents
        SET content = #{content},
            version = version + 1
        WHERE id = #{id}
          AND version = #{version}
          AND is_deleted = 0
    </update>

    <update id="softDeleteById">
        UPDATE documents
        SET is_deleted = 1
        WHERE id = #{id}
          AND is_deleted = 0
    </update>
</mapper>
